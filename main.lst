 12+  803E                  ; 1.- Calculate position in hl register: hl =  32*Y + X + $5800
 13+  803E
 14+  803E 69               ld l,c      ; L = Y, l is the least significant bit part of hl
 15+  803F 26 00            ld h, 0     ; now hl = Y
 16+  8041
 17+  8041                  ; It is more eficient to do a "unwound loop" (bucle desenrollado)
 18+  8041                  ; than to make a actual loop
 19+  8041 29               add hl,hl   ; hl_1 = hl + hl = 2*hl
 20+  8042 29               add hl,hl   ; hl_2 = 2hl + 2hl = 4hl
 21+  8043 29               add hl,hl   ; hl_3 = 4hl + 4hl = 8hl
 22+  8044 29               add hl,hl   ; hl_4 = 8hl + 8hl = 16hl
 23+  8045 29               add hl,hl   ; hl_5 = 16hl + 16hl = 32hl
 24+  8046
 25+  8046                  ; now hl = Y*32, so we need to add $5800 and X:
 26+  8046 11 00 58         ld de, $5800    ; de = $5800
 27+  8049 19               add hl, de      ; hl = 32*  Y + $5800
 28+  804A
 29+  804A 58               ld e, b         ; we only need one reg to make e = X (b=X)
 30+  804B 16 00            ld d, $00       ; we reset d reg to 00 so we dont add 58 (previous value)
 31+  804D 19               add hl, de      ; hl = 32*Y + $5800 + X
 32+  804E
 33+  804E                  ; now that we have the coordinates decoded, lets paint the dot:
 34+  804E                  ; For that first we need to move the value of the color to its
 35+  804E                  ; corresponding position:
 36+  804E
 37+  804E                  ; a = Color, so to get Color * 8 we do:
 38+  804E 87               add a           ; a_1 =  a  + a = 2a = Color *2
 39+  804F 87               add a           ; a_2 = 2a + 2a = 4a = Color *4
 40+  8050 87               add a           ; a_3 = 4a + 4a = 8a = Color *8
 41+  8051
 42+  8051                  ; Now we set the atribute of the register corresponding to the
 43+  8051                  ; given coordinates to the color after moving it left thrice so
 44+  8051                  ; as to get the intended result.
 45+  8051
 46+  8051 77               ld (hl),a
 47+  8052
 48+  8052                  ; Now that the function is finished we return all the registers
 49+  8052                  ; and flags unmodified.
